{
  "expo": {
    "name": "NexusClass",
    "slug": "nexusclass",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/nexusclass-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/nexusclass-icon.png",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/nexusclass-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.professorpayapp"
    },
    "web": {
      "favicon": "./assets/nexusclass-icon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
