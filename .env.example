# Browser-visible URL. When using Docker Compose, the browser reaches the API
# through localhost rather than the internal Docker service name.
# Web app (Vercel + Firebase). These values come from Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Administração e auditoria de acesso (somente no servidor; nunca use NEXT_PUBLIC_).
# Lista separada por vírgula dos e-mails autorizados a abrir /admin.
ADMIN_EMAILS=admin@exemplo.com
# JSON completo da chave de uma service account Firebase, em uma única linha.
# Cadastre somente no ambiente do servidor/Vercel; não versione a chave.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Legacy API (migration-only; the web app no longer uses this in production).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API configuration
APP_ENV=development
API_PORT=8000
# The default is a SQLite file at backend/data/aulapay.sqlite3. Leave this
# unset unless an absolute custom SQLite path or another supported database is
# intentionally required.
# DATABASE_URL=sqlite+pysqlite:////absolute/path/to/aulapay.sqlite3
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
