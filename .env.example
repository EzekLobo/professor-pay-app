# Docker Compose development configuration
POSTGRES_DB=aulapay
POSTGRES_USER=aulapay
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Browser-visible URL. When using Docker Compose, the browser reaches the API
# through localhost rather than the internal Docker service name.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API configuration
APP_ENV=development
API_PORT=8000
DATABASE_URL=postgresql+psycopg://aulapay:change-me-for-local-development@db:5432/aulapay
CORS_ORIGINS=http://localhost:3000
