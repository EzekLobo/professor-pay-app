APP_ENV=development
# By default the API persists to apps/api/data/aulapay.sqlite3. Keep this
# unset for the portable repository-local database. Uncomment only to override
# it with an absolute SQLite path or another supported database.
# DATABASE_URL=sqlite+pysqlite:////absolute/path/to/aulapay.sqlite3
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Registration is enabled by default only in development.
# REGISTRATION_ENABLED=false
