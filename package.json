{
  "name": "professor-pay-app",
  "version": "1.0.0",
  "main": "index.ts",
  "workspaces": [
    "frontend"
  ],
  "dependencies": {
    "@expo/ui": "~56.0.14",
    "expo": "~56.0.5",
    "expo-clipboard": "~56.0.3",
    "expo-secure-store": "~56.0.4",
    "expo-sqlite": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1",
    "apk:install": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1 -InstallEmulator",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "npm run dev --workspace=@aulapay/web",
    "web:build": "npm run build --workspace=@aulapay/web",
    "web:lint": "npm run lint --workspace=@aulapay/web",
    "web:typecheck": "npm run typecheck --workspace=@aulapay/web",
    "web:test": "npm run test --workspace=@aulapay/web",
    "web:coverage": "npm run test:coverage --workspace=@aulapay/web",
    "web:e2e": "npm run test:e2e --workspace=@aulapay/web",
    "api:lint": "uv --directory backend run ruff check .",
    "api:test": "uv --directory backend run pytest",
    "quality": "npm run web:lint && npm run web:typecheck && npm run web:test && npm run web:build && npm run api:lint && npm run api:test"
  },
  "private": true
}
